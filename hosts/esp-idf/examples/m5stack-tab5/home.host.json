{
  "$schema": "https://pocketjs.dev/schema/pocket-idf-host-1.json",
  "version": 1,
  "id": "tab5-home",
  "platform": "esp-idf",
  "form": "takeover",
  "tickHz": 30,
  "display": {
    "physicalViewport": [800, 480],
    "logicalViewports": [[400, 240]],
    "presentations": ["native"],
    "rasterDensity": 2,
    "auxiliary": {
      "physicalViewport": [720, 1184],
      "logicalViewports": [[360, 592]],
      "presentations": ["native"],
      "rasterDensity": 2
    }
  },
  "capabilities": [
    "input.buttons",
    "input.touch.auxiliary",
    "display.auxiliary",
    "text.glyphs.baked",
    "net.http",
    "link.companion",
    "system.wifi",
    "camera.qr",
    "camera.photo",
    "data.fs",
    "media.playback"
  ]
}
